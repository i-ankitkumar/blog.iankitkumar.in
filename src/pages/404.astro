---
import Base from '~/layouts/Base.astro';
---

<Base title="Not found" description="That page is not in the log." noindex>
  <section class="container">
    <div class="notfound">
      <p class="code">404</p>
      <h1 style="margin-block: 1rem 0.75rem">This page is not in the log.</h1>
      <p class="lede">
        The address may have changed, or the note may never have existed. Everything that does
        exist is one click away.
      </p>
      <p style="margin-top: 2rem">
        <a class="back-link" href="/blog/">← All notes</a>
      </p>
    </div>
  </section>
</Base>
