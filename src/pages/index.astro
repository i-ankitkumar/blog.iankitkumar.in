---
import Ledger from '~/components/Ledger.astro';
import Base from '~/layouts/Base.astro';
import { formatDate, getPublishedPosts, getTags } from '~/lib/posts';
import { SITE } from '~/lib/site';

const posts = await getPublishedPosts();
const tags = await getTags();
const latest = posts[0];
---

<Base>
  <section class="masthead">
    <div class="container">
      <p class="label">Field log · infrastructure notes</p>
      <h1>What broke, what I changed, what I&rsquo;d repeat.</h1>
      <p class="lede">
        Short, practical notes from production work — Splunk, Azure, AWS, Terraform, automation,
        and reliability. Written by Ankit Kumar while the details are still fresh.
      </p>
      <div class="masthead-meta">
        <div>
          <span class="label">Entries</span>
          <span class="value">{posts.length}</span>
        </div>
        <div>
          <span class="label">Topics</span>
          <span class="value">{tags.length}</span>
        </div>
        {
          latest && (
            <div>
              <span class="label">Latest</span>
              <span class="value">{formatDate(latest.data.pubDate)}</span>
            </div>
          )
        }
        <div>
          <span class="label">Author</span>
          <span class="value">{SITE.name}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Latest notes</h2>
        <a class="label label--accent" href="/blog/">All notes →</a>
      </div>
      <Ledger posts={posts.slice(0, 5)} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>What this log covers</h2>
      </div>
      <ul class="tags">
        {
          tags.map((entry) => (
            <li>
              <a class="tag" href={`/topics/${entry.slug}/`}>
                {entry.tag}
                <span class="tag-count">{entry.posts.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>About this log</h2>
      </div>
      <div class="prose">
        <p>
          This is the writing half of <a href={SITE.portfolioUrl}>iankitkumar.in</a>. The portfolio
          holds the record of what I&rsquo;ve built; this holds the notes I wanted to keep when the
          ticket closed.
        </p>
        <p>
          Entries are short on purpose. If a note needs a diagram, an appendix, or three paragraphs
          of context before it starts, it belongs in a document, not here. What belongs here is the
          thing you would want in your hands at 2&nbsp;a.m. with a broken pipeline.
        </p>
      </div>
    </div>
  </section>
</Base>
