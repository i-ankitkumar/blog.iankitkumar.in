---
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import MobileSocials from '@components/home/MobileSocials.astro';
import { Button, Card, Pill } from '@eliancodes/brutal-ui';
import Layout from '@layouts/Default.astro';

const builtWith = [
  { name: 'Astro', url: 'https://astro.build/' },
  { name: 'Brutal theme', url: 'https://github.com/eliancodes/brutal' },
  { name: 'Cloudflare Pages', url: 'https://pages.cloudflare.com/' },
  { name: 'Markdown', url: 'https://www.markdownguide.org/' },
  { name: 'RSS', url: 'https://docs.astro.build/en/guides/rss/' },
  { name: 'Sitemap', url: 'https://docs.astro.build/en/guides/integrations-guide/sitemap/' },
];
---

<Layout
  title='Home'
  pageTitle='blog.iankitkumar.in | Home'
  description='Learning notes by Ankit Kumar — DevOps, cloud, Splunk, Azure, Terraform, and infrastructure automation.'
>
  <main class='bg-pink-theme p-6'>
    <MobileSocials />
    <section id='about' class='grid md:grid-cols-8 gap-8 mt-4'>
      <h2 class='hidden'>About</h2>
      <div class='col-span-4'>
        <Card>
          <div class='flex flex-col justify-between items-start gap-4'>
            <p class='mt-4 outfit text-2xl md:text-5xl lg:text-7xl'>
              Learning in public
            </p>
            <p class='mt-2 outfit text-xl md:text-3xl lg:text-5xl'>
              DevOps, cloud &amp; infrastructure notes by Ankit Kumar.
            </p>
            <Button target={'_self'} href='/blog/'>
              Read the blog &rarr;
            </Button>
          </div>
        </Card>
      </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif'>
            Built with
          </h2>
          <ul class='flex gap-4 flex-wrap'>
            {
              builtWith.map((item) => (
                <li>
                  <Pill>
                    <a
                      class='sanchez'
                      href={item.url}
                      target='_blank'
                      rel='noopener'
                      title={`Go to ${item.name}`}
                    >
                      {item.name}
                    </a>
                  </Pill>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>
            Who
          </h2>
          <p class='poppins'>
            I&apos;m a DevOps &amp; Cloud Infrastructure Engineer writing short,
            practical notes from production work — Splunk, Azure, Terraform,
            automation, and reliability. Portfolio lives at
            <a href='https://iankitkumar.in'>iankitkumar.in</a>.
          </p>
        </Card>
      </div>
    </section>
    <RecentBlogPosts />
  </main>
</Layout>
