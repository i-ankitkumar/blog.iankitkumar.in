---
import Ledger from '~/components/Ledger.astro';
import Base from '~/layouts/Base.astro';
import { getPublishedPosts } from '~/lib/posts';

const posts = await getPublishedPosts();
---

<Base
  title="All notes"
  description="Every published note in the log — DevOps, cloud, Splunk, Azure, Terraform, and automation."
>
  <section class="masthead">
    <div class="container">
      <p class="label">Log · {posts.length} entries</p>
      <h1>All notes</h1>
      <p class="lede">
        Every published entry, newest first. Each one is short, dated, and filed under a topic.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Ledger posts={posts} />
    </div>
  </section>
</Base>
