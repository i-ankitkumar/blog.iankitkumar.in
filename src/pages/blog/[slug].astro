---
import { render } from 'astro:content';
import Post from '~/layouts/Post.astro';
import { getPublishedPosts } from '~/lib/posts';
import { SITE } from '~/lib/site';

export async function getStaticPaths() {
  // Only published posts get a page. A draft is not built, so it cannot
  // be reached, indexed, or linked to by accident.
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const url = new URL(`/blog/${post.id}/`, SITE.siteUrl).toString();

const jsonLd = {
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  mainEntityOfPage: url,
  url,
  image: new URL(`/og/${post.id}.png`, SITE.siteUrl).toString(),
  keywords: post.data.tags.join(', '),
  wordCount: post.body?.split(/\s+/).filter(Boolean).length ?? 0,
  author: {
    '@type': 'Person',
    name: post.data.author,
    url: SITE.portfolioUrl,
  },
  publisher: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.siteUrl,
  },
};
---

<Post
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  tags={post.data.tags}
  headings={headings}
  body={post.body}
  ogImage={`/og/${post.id}.png`}
  jsonLd={jsonLd}
>
  <Content />
</Post>
